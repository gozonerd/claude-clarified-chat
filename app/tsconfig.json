{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src", "e2e", "*.config.ts", "*.config.mjs"]
}
